<!--
  Relatorio.html
  ---------------------------------------------------------------------
  Template usado exclusivamente para gerar o PDF (não aparece na tela).

  IMPORTANTE: o conversor HTML->PDF do Apps Script (usado em
  Relatorios.gs via Utilities.newBlob(...).getAs('application/pdf'))
  NÃO suporta bem CSS moderno como "display: grid" ou "display: flex".
  Esse layout usa apenas <table>, que é o que renderiza de forma
  confiável nesse conversor.
-->
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: Arial, sans-serif;
      color: #1f2937;
      font-size: 12px;
      padding: 20px 30px;
    }
    table {
      border-collapse: collapse;
      width: 100%;
    }
    .cabecalho-tabela td {
      vertical-align: middle;
      padding-bottom: 10px;
      border-bottom: 3px solid #1e3a8a;
    }
    .logo {
      font-size: 14px;
      font-weight: bold;
      color: #1e3a8a;
      letter-spacing: 1px;
    }
    .titulo-principal {
      text-align: right;
    }
    .titulo-principal h1 {
      margin: 0;
      font-size: 18px;
      color: #111827;
    }
    .titulo-principal p {
      margin: 2px 0 0;
      font-size: 12px;
      color: #6b7280;
    }
    .status-badge {
      display: inline-block;
      margin-top: 4px;
      padding: 3px 10px;
      border-radius: 4px;
      background-color: #dcfce7;
      color: #166534;
      font-weight: bold;
      font-size: 11px;
    }
    .secao-titulo {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #1e3a8a;
      border-bottom: 1px solid #e5e7eb;
      padding-bottom: 4px;
      margin-top: 22px;
      margin-bottom: 10px;
    }
    .campos-tabela td {
      width: 50%;
      padding: 4px 10px 10px 0;
      vertical-align: top;
    }
    .rotulo {
      display: block;
      font-size: 10px;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .valor {
      display: block;
      font-size: 13px;
      font-weight: bold;
      color: #111827;
    }
    .texto-bloco {
      background-color: #f9fafb;
      border: 1px solid #e5e7eb;
      padding: 10px 12px;
      font-size: 12px;
    }
    .rodape {
      margin-top: 30px;
      padding-top: 10px;
      border-top: 1px solid #e5e7eb;
      font-size: 10px;
      color: #9ca3af;
      text-align: center;
    }
  </style>
</head>
<body>

  <table class="cabecalho-tabela">
    <tr>
      <td class="logo">SUPERVISÓRIO DE MANUTENÇÃO</td>
      <td class="titulo-principal">
        <h1>Relatório de Manutenção</h1>
        <p>Requisição Nº <?= dados.numero ?></p>
        <span class="status-badge"><?= dados.status ?></span>
      </td>
    </tr>
  </table>

  <div class="secao-titulo">Dados da Solicitação</div>
  <table class="campos-tabela">
    <tr>
      <td>
        <span class="rotulo">Solicitante</span>
        <span class="valor"><?= dados.solicitante ?></span>
      </td>
      <td>
        <span class="rotulo">Setor</span>
        <span class="valor"><?= dados.setor ?></span>
      </td>
    </tr>
    <tr>
      <td>
        <span class="rotulo">Máquina</span>
        <span class="valor"><?= dados.maquina ?></span>
      </td>
      <td>
        <span class="rotulo">Tempo de Atendimento</span>
        <span class="valor"><?= dados.tempoAtendimento ?></span>
      </td>
    </tr>
    <tr>
      <td>
        <span class="rotulo">Data da Abertura</span>
        <span class="valor"><?= dados.dataAbertura ?></span>
      </td>
      <td>
        <span class="rotulo">Data do Encerramento</span>
        <span class="valor"><?= dados.dataEncerramento ?></span>
      </td>
    </tr>
  </table>

  <div class="secao-titulo">Execução</div>
  <table class="campos-tabela">
    <tr>
      <td>
        <span class="rotulo">Responsável</span>
        <span class="valor"><?= dados.responsavel ?></span>
      </td>
      <td>
        <span class="rotulo">Local da Falha</span>
        <span class="valor"><?= dados.localFalha ?></span>
      </td>
    </tr>
    <tr>
      <td>
        <span class="rotulo">Modo de Falha</span>
        <span class="valor"><?= dados.modoFalha ?></span>
      </td>
      <td>
        <span class="rotulo">Componentes com Defeito</span>
        <span class="valor"><?= dados.componentes ?></span>
      </td>
    </tr>
  </table>

  <div class="secao-titulo">Ação Executada</div>
  <div class="texto-bloco"><?= dados.acaoExecutada ?></div>

  <div class="secao-titulo">Observações</div>
  <div class="texto-bloco"><?= dados.observacoes ?></div>

  <div class="rodape">
    Relatório gerado automaticamente pelo Supervisório de Manutenção<br>
    Desenvolvido por João Victor Olinto Bernardo
  </div>

</body>
</html>
