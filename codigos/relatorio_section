<section id="relatorios-section" class="max-w-3xl mx-auto p-6">

  <h1 class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-2">
    📄 Relatórios
  </h1>

  <!-- Campo de busca -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <label for="rel-input-numero" class="block text-sm font-medium text-slate-600 mb-1">
      Número da Requisição
    </label>
    <div class="flex gap-2">
      <input
        id="rel-input-numero"
        type="text"
        placeholder="Ex: 1024"
        class="flex-1 border border-slate-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
      <button
        id="rel-btn-pesquisar"
        class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-md transition disabled:opacity-50"
      >
        🔍 Pesquisar
      </button>
    </div>
  </div>

  <!-- Mensagens de estado (não encontrada / não encerrada / erro) -->
  <div id="rel-mensagem" class="hidden rounded-md p-4 mb-6 text-sm font-medium"></div>

  <!-- Carregando -->
  <div id="rel-carregando" class="hidden text-center text-slate-500 mb-6">
    Consultando requisição...
  </div>

  <!-- Resumo da requisição -->
  <div id="rel-resumo" class="hidden bg-white rounded-lg shadow p-4 mb-6">
    <div class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <span class="block text-slate-400 uppercase text-xs">Status</span>
        <span id="rel-campo-status" class="font-semibold text-slate-800"></span>
      </div>
      <div>
        <span class="block text-slate-400 uppercase text-xs">Máquina</span>
        <span id="rel-campo-maquina" class="font-semibold text-slate-800"></span>
      </div>
      <div>
        <span class="block text-slate-400 uppercase text-xs">Solicitante</span>
        <span id="rel-campo-solicitante" class="font-semibold text-slate-800"></span>
      </div>
      <div>
        <span class="block text-slate-400 uppercase text-xs">Setor</span>
        <span id="rel-campo-setor" class="font-semibold text-slate-800"></span>
      </div>
      <div>
        <span class="block text-slate-400 uppercase text-xs">Responsável</span>
        <span id="rel-campo-responsavel" class="font-semibold text-slate-800"></span>
      </div>
      <div>
        <span class="block text-slate-400 uppercase text-xs">Tempo Total</span>
        <span id="rel-campo-tempo" class="font-semibold text-slate-800"></span>
      </div>
      <div>
        <span class="block text-slate-400 uppercase text-xs">Abertura</span>
        <span id="rel-campo-abertura" class="font-semibold text-slate-800"></span>
      </div>
      <div>
        <span class="block text-slate-400 uppercase text-xs">Encerramento</span>
        <span id="rel-campo-encerramento" class="font-semibold text-slate-800"></span>
      </div>
    </div>
  </div>

  <!-- Botão de geração do PDF -->
  <div class="text-right">
    <button
      id="rel-btn-gerar-pdf"
      disabled
      class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-5 py-2 rounded-md transition disabled:opacity-40 disabled:cursor-not-allowed"
    >
      📄 Gerar PDF
    </button>
  </div>

</section>

